package entities

import "github.com/keyxmakerx/chronicle/internal/plugins/campaigns"

// effectiveVisibilityBadge is the show-page header's call site for the shared
// visibilityGlance component (ADR-057 slice 3). It used to be its own
// hand-rolled copy of the globe/lock/shield vocabulary (and the only one of
// the seven that threaded the tag-widening EffectiveVisibility through); it
// is now a thin pass-through so the header keeps its own name — slice 4's
// hover popover mounts here — while the gate, glyphs, and colours all live in
// one place.
templ effectiveVisibilityBadge(cc *campaigns.CampaignContext, entity *Entity, ev *EffectiveVisibility) {
	@visibilityGlance(cc, entity, ev)
}
